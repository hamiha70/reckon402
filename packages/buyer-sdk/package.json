{
  "name": "@reckon402/buyer-sdk",
  "version": "0.1.0",
  "description": "Buyer-side helpers for the Reckon402 x402 v2 flow: sign EIP-3009 authorizations, encode/decode payment headers, derive paymentId.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "github:hamiha70/reckon402"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "rm -rf dist && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@reckon402/types": "workspace:*",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
