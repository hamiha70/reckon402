{
  "name": "@reckon402/facilitator-client",
  "version": "0.1.0",
  "private": false,
  "description": "HTTP clients implementing the @reckon402/types Facilitator interface: CdpFacilitator (x402.org) + Reckon402Facilitator (facilitator.reckon402.com).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "github:hamiha70/reckon402"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "rm -rf dist && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@reckon402/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
