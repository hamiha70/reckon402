{
  "name": "@reckon402/types",
  "version": "0.1.0",
  "private": false,
  "description": "Canonical x402 v2 wire-format types for Reckon402",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "github:hamiha70/reckon402"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
